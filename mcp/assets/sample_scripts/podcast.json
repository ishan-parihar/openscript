{
  "$schema": "openscript-video/v1",
  "title": "AI Podcast — Episode 1",
  "meta": {
    "aspect": "9:16",
    "fps": 30,
    "width": 1080,
    "height": 1920,
    "resolution": "1080p"
  },
  "tts": {
    "backend": "kokoro",
    "default_speed": 1.0,
    "default_pitch": 1.0
  },
  "speakers": {
    "alice": {
      "voice": "kokoro:af_heart",
      "preset": "default_person",
      "position": "top-left",
      "scale": 0.25,
      "emote_default": "neutral"
    },
    "bob": {
      "voice": "kokoro:am_michael",
      "preset": "robot",
      "position": "top-right",
      "scale": 0.25,
      "emote_default": "neutral"
    }
  },
  "background": {
    "type": "gameplay",
    "source": "youtube",
    "query": "minecraft parkour no copyright gameplay",
    "fallback_pool": ["mcp/assets/backgrounds/procedural_waves_purple.mp4", "mcp/assets/backgrounds/procedural_waves_teal.mp4"],
    "crop_mode": "center",
    "loop": true,
    "volume_db": -20,
    "change_cadence": "scene"
  },
  "music": {
    "path": "mcp/assets/music/lofi_chill.mp3",
    "gain_db": -18,
    "ducking": true,
    "ducking_depth_db": 12
  },
  "captions": {
    "style": "word_highlight",
    "font": "Bebas Neue",
    "font_size": 72,
    "color": "#ffffff",
    "highlight_color": "#00ff88",
    "position": "bottom",
    "safe_zone": 0.85,
    "max_words_per_line": 5
  },
  "speaker_layout": "split_top",
  "stickers": {
    "enabled": true,
    "lip_sync": "amplitude",
    "blink": true,
    "idle_bob": true
  },
  "scenes": [
    {
      "speaker": "alice",
      "text": "Welcome to the AI Podcast! Today we're diving into something amazing.",
      "emote": "happy"
    },
    {
      "speaker": "bob",
      "text": "That's right. We'll be exploring how neural networks actually work.",
      "emote": "neutral"
    },
    {
      "speaker": "alice",
      "text": "Let's start with the basics. A neural network is inspired by the human brain.",
      "emote": "thinking"
    },
    {
      "speaker": "bob",
      "text": "Exactly. It has layers of interconnected nodes that process information.",
      "emote": "neutral"
    },
    {
      "speaker": "alice",
      "text": "And when you train it with enough data, it can recognize patterns!",
      "emote": "surprised"
    },
    {
      "speaker": "bob",
      "text": "That's the magic. Thanks for watching, and see you next time!",
      "emote": "happy"
    }
  ],
  "sfx": [
    {"at_ms": 0, "role": "intro"},
    {"at_ms": null, "role": "transition", "trigger": "scene_change"}
  ],
  "output": {
    "format": "mp4",
    "codec": "h264",
    "crf": 18,
    "preset": "slow"
  }
}
