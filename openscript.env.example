# OpenScript environment template — copy values into your shell profile
# or pass them once to:
#   bash scripts/setup_openscript_config.sh
#
# Never commit a filled-in copy of this file.
# Canonical secrets store: ~/.openscript/config.json (mode 0600)

# --- Required for production stock B-roll ---
PEXELS_API_KEY=

# --- Stickers / reaction GIFs ---
GIPHY_API_KEY=

# --- Optional music/video alt ---
PIXABAY_API_KEY=

# --- Optional vision cascade (OpenRouter free models) ---
OPENROUTER_API_KEY=

# --- Optional TTS engine defaults (script.to_video) ---
# Default audio model engine when a script omits tts.backend:
#   kokoro (presets) | audio8 (zero-shot clone, ONNX INT4) | sidecar
# OPENSCRIPT_TTS_BACKEND=kokoro
# Default voice profile id used when a speaker's voice is "default":
# OPENSCRIPT_TTS_VOICE=ishan

# --- Feature toggles (what setup.sh provisions + what the runtime enables) ---
# All default ON. Config surface: ~/.openscript/config.json → features.<category>.<name>
#   (bash scripts/setup_openscript_config.sh --feature tts.voicedesign=0)
# Env override (0|1|true|false):
# OPENSCRIPT_FEATURE_TTS_VOICEDESIGN=0   # skip the 4.3GB Qwen3 VoiceDesign model
# OPENSCRIPT_FEATURE_TTS_AUDIO8=0        # skip the ~1GB Audio8 clone model
# OPENSCRIPT_FEATURE_TTS_KOKORO=0        # skip Kokoro model + kokoro-onnx deps
# OPENSCRIPT_FEATURE_TRANSCRIPTION_PARAKEET_ALIGN=0  # skip the 320MB Parakeet model
# OPENSCRIPT_FEATURE_TRANSCRIPTION_HINGLISH_GGML=0   # skip whisper.cpp build
# OPENSCRIPT_FEATURE_MEDIA_YOUTUBE=0     # gate youtube.search/download
# OPENSCRIPT_FEATURE_LLM_OPENROUTER=0    # drop OpenRouter from the LLM cascade
# OPENSCRIPT_FEATURE_FRONTEND=0          # skip npm install (Tauri/React UI)
# bash setup.sh --list-features          # print the full toggle table

# --- Optional paths ---
# OPENSCRIPT_SFX_PATH=$HOME/Videos/Assets/SFX
# OPENSCRIPT_ROOT=
# OPENSCRIPT_ALLOW_PROCEDURAL=0
