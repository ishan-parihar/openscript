# OpenScript environment template — copy values into your shell profile
# or pass them once to:
#   bash scripts/setup_openscript_config.sh
#
# Never commit a filled-in copy of this file.
# Canonical secrets store: ~/.openscript/config.json (mode 0600)

# --- Required for production stock B-roll ---
PEXELS_API_KEY=

# --- Stickers / reaction GIFs ---
GIPHY_API_KEY=

# --- Optional music/video alt ---
PIXABAY_API_KEY=

# --- Optional vision cascade (OpenRouter free models) ---
OPENROUTER_API_KEY=

# --- Optional paths ---
# OPENSCRIPT_SFX_PATH=$HOME/Videos/Assets/SFX
# OPENSCRIPT_ROOT=
# OPENSCRIPT_ALLOW_PROCEDURAL=0
