  "segments": [
    {
      "id": "scene_001",
      "start": 0.0,
      "end": 1.664,
      "caption": "Every system has a purpose.",
      "crossfade_ms": 0,
      "semantic_role": null
    },
    {
      "id": "scene_002",
      "start": 1.664,
      "end": 4.821,
      "caption": "But what happens when the system itself becomes the problem?",
      "crossfade_ms": 0,
      "semantic_role": null
    },
    {
      "id": "scene_003",
      "start": 4.821,
      "end": 9.002,
      "caption": "This is the Pathological Orange stage from Spiral Dynamics.",
      "crossfade_ms": 0,
      "semantic_role": null
    },
    {
      "id": "scene_004",
      "start": 9.002,
      "end": 11.839,
      "caption": "It is when efficiency turns into exploitation.",
      "crossfade_ms": 0,
      "semantic_role": null
    },
    {
      "id": "scene_005",
      "start": 11.839,
      "end": 14.826,
      "caption": "The economic system was designed to create wealth.",
      "crossfade_ms": 0,
      "semantic_role": null
    },
    {
      "id": "scene_006",
      "start": 14.826,
      "end": 17.023,
      "caption": "But it now creates inequality instead.",
      "crossfade_ms": 0,
      "semantic_role": null
    },
    {
      "id": "scene_007",
      "start": 17.023,
      "end": 19.37,
      "caption": "The rich get richer. The poor stay poor.",
      "crossfade_ms": 0,
      "semantic_role": null
    },
    {
      "id": "scene_008",
      "start": 19.37,
      "end": 20.97,
      "caption": "The middle class disappears.",
      "crossfade_ms": 0,
      "semantic_role": null
    },
    {
      "id": "scene_009",
      "start": 20.97,
      "end": 25.599,
      "caption": "Wealth concentrates at the top. Resources flow upward, never trickling down.",
      "crossfade_ms": 0,
      "semantic_role": null
    },
    {
      "id": "scene_010",
      "start": 25.599,
      "end": 29.012,
      "caption": "The political system was designed to represent the people.",
      "crossfade_ms": 0,
      "semantic_role": null
    },
    {
      "id": "scene_011",
      "start": 29.012,
      "end": 30.527,
      "caption": "But it represents the money.",
      "crossfade_ms": 0,
      "semantic_role": null
    },
    {
      "id": "scene_012",
      "start": 30.527,
      "end": 34.111,
      "caption": "Lobbyists write the laws. Corporations fund the campaigns.",
      "crossfade_ms": 0,
      "semantic_role": null
    },
    {
      "id": "scene_013",
      "start": 34.111,
      "end": 36.01,
      "caption": "The people get the illusion of choice.",
      "crossfade_ms": 0,
      "semantic_role": null
    },
    {
      "id": "scene_014",
      "start": 36.01,
      "end": 38.335,
      "caption": "Privileges are distributed unequally.",
      "crossfade_ms": 0,
      "semantic_role": null
    },
    {
      "id": "scene_015",
      "start": 38.335,
      "end": 40.447,
      "caption": "Justice depends on your bank account.",
      "crossfade_ms": 0,
      "semantic_role": null
    },
    {
      "id": "scene_016",
      "start": 40.447,
      "end": 43.263,
      "caption": "The wealthy get bailouts. The poor get sentences.",
      "crossfade_ms": 0,
      "semantic_role": null
    },
    {
      "id": "scene_017",
      "start": 43.263,
      "end": 45.738,
      "caption": "Corruption is not a bug. It is a feature.",
      "crossfade_ms": 0,
      "semantic_role": null
    },
    {
      "id": "scene_018",
      "start": 45.738,
      "end": 49.45,
      "caption": "The justice system degrades. Laws become tools of oppression.",
      "crossfade_ms": 0,
      "semantic_role": null
    },
    {
      "id": "scene_019",
      "start": 49.45,
      "end": 53.397,
      "caption": "Regulatory capture means the regulators work for the regulated.",
      "crossfade_ms": 0,
      "semantic_role": null
    }
  ],
