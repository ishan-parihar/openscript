  "segments": [
    {
      "id": "scene_001",
      "start": 0.0,
      "end": 1.984,
      "caption": "What does the future of AI look like?",
      "crossfade_ms": 0,
      "semantic_role": null
    },
    {
      "id": "scene_002",
      "start": 1.984,
      "end": 4.672,
      "caption": "It is not just about smarter models.",
      "crossfade_ms": 0,
      "semantic_role": null
    },
    {
      "id": "scene_003",
      "start": 4.672,
      "end": 7.573,
      "caption": "It is about AI that can reason, plan, and act.",
      "crossfade_ms": 0,
      "semantic_role": null
    },
    {
      "id": "scene_004",
      "start": 7.573,
      "end": 11.477,
      "caption": "Imagine AI agents that can use tools autonomously.",
      "crossfade_ms": 0,
      "semantic_role": null
    },
    {
      "id": "scene_005",
      "start": 11.477,
      "end": 14.442,
      "caption": "They could write code, design systems, and create art.",
      "crossfade_ms": 0,
      "semantic_role": null
    },
    {
      "id": "scene_006",
      "start": 14.442,
      "end": 17.343,
      "caption": "But with great power comes great responsibility.",
      "crossfade_ms": 0,
      "semantic_role": null
    },
    {
      "id": "scene_007",
      "start": 17.343,
      "end": 20.266,
      "caption": "We need alignment. We need safety. We need trust.",
      "crossfade_ms": 0,
      "semantic_role": null
    },
    {
      "id": "scene_008",
      "start": 20.266,
      "end": 23.167,
      "caption": "The future is not AI versus humans.",
      "crossfade_ms": 0,
      "semantic_role": null
    },
    {
      "id": "scene_009",
      "start": 23.167,
      "end": 25.642,
      "caption": "It is humans and AI, working together.",
      "crossfade_ms": 0,
      "semantic_role": null
    },
    {
      "id": "scene_010",
      "start": 25.642,
      "end": 27.519,
      "caption": "That is the future worth building.",
      "crossfade_ms": 0,
      "semantic_role": null
    }
  ],
