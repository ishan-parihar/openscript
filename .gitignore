# Existing
target/
node_modules/
third_party/faster-qwen3-tts/

# Large model assets (download separately, don't commit)
mcp/assets/kokoro/onnx/*.onnx
mcp/assets/kokoro/voices/*.bin
**/background_cache/
**/broll_cache/
artifacts/
!test_fixtures/
# Ignore auto-generated WAV pre-decodes from audio-only renders
test_fixtures/*.wav
test_fixtures/*.hinglish.wav

# Generated JSON indices — regenerable at runtime via library.build / sfx.index.
# music_library_index.json is fully regenerable and not used by any test, so
# it is gitignored. (sfx_index.json IS used by test_mcp_sfx_search, so it is
# kept committed for now — to remove it, the test would need to regenerate it
# at the start of the run.)
mcp/assets/music_library_index.json

# Render output + TTS cache (never commit)
*.reel.mp4
*.render.log
*.concat.txt
*.align.json
openscript-tts-cache/

# Python
__pycache__/
*.pyc
.venv/

# IDE
.vscode/
.idea/
*.swp
artifacts_test/
artifacts_*/

# Environment files (never commit secrets)
.env
.env.local
.env.*.local

# OS files
.DS_Store
Thumbs.db
snapshots/
renders/
# Downloaded media assets (fetched on-demand via tools, never commit binaries)
mcp/assets/sfx_library/
mcp/assets/music_cache/

mcp/assets/.openscript_config.json
mcp/assets/kokoro/
mcp/assets/parakeet/
mcp/assets/omnivoice/
mcp/assets/audio8/

# Large binary assets (regenerated at runtime)
models/nemotron-onnx/
output/

# Runtime caches / agent state dirs (never commit)
.contexty/
.cortexkit/
.sisyphus/
.hive/
