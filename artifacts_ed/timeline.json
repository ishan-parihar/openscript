  "segments": [
    {
      "id": "scene_001",
      "start": 0.0,
      "end": 5.056,
      "caption": "Every system has a purpose. But what happens when the system itself becomes the problem?",
      "crossfade_ms": 0,
      "semantic_role": null
    },
    {
      "id": "scene_002",
      "start": 5.056,
      "end": 12.373,
      "caption": "This is the Pathological Orange stage from Spiral Dynamics. It is when efficiency turns into exploitation.",
      "crossfade_ms": 0,
      "semantic_role": null
    },
    {
      "id": "scene_003",
      "start": 12.373,
      "end": 18.048,
      "caption": "The economic system was designed to create wealth. But it now creates inequality instead.",
      "crossfade_ms": 0,
      "semantic_role": null
    },
    {
      "id": "scene_004",
      "start": 18.048,
      "end": 22.059,
      "caption": "The rich get richer. The poor stay poor. The middle class disappears.",
      "crossfade_ms": 0,
      "semantic_role": null
    },
    {
      "id": "scene_005",
      "start": 22.059,
      "end": 26.688,
      "caption": "Wealth concentrates at the top. Resources flow upward, never trickling down.",
      "crossfade_ms": 0,
      "semantic_role": null
    },
    {
      "id": "scene_006",
      "start": 26.688,
      "end": 31.595,
      "caption": "The political system was designed to represent the people. But it represents the money.",
      "crossfade_ms": 0,
      "semantic_role": null
    },
    {
      "id": "scene_007",
      "start": 31.595,
      "end": 37.504,
      "caption": "Lobbyists write the laws. Corporations fund the campaigns. The people get the illusion of choice.",
      "crossfade_ms": 0,
      "semantic_role": null
    },
    {
      "id": "scene_008",
      "start": 37.504,
      "end": 42.027,
      "caption": "Privileges are distributed unequally. Justice depends on your bank account.",
      "crossfade_ms": 0,
      "semantic_role": null
    },
    {
      "id": "scene_009",
      "start": 42.027,
      "end": 46.678,
      "caption": "The wealthy get bailouts. The poor get sentences. The system protects itself.",
      "crossfade_ms": 0,
      "semantic_role": null
    },
    {
      "id": "scene_010",
      "start": 46.678,
      "end": 52.374,
      "caption": "Corruption is not a bug. It is a feature of a system designed by the powerful, for the powerful.",
      "crossfade_ms": 0,
      "semantic_role": null
    },
    {
      "id": "scene_011",
      "start": 52.374,
      "end": 57.089,
      "caption": "The justice system degrades. Laws become tools of oppression, not protection.",
      "crossfade_ms": 0,
      "semantic_role": null
    },
    {
      "id": "scene_012",
      "start": 57.089,
      "end": 62.998,
      "caption": "Regulatory capture means the regulators work for the regulated. The fox guards the henhouse.",
      "crossfade_ms": 0,
      "semantic_role": null
    },
    {
      "id": "scene_013",
      "start": 62.998,
      "end": 68.31,
      "caption": "Media consolidation means a few corporations control what you see, hear, and think.",
      "crossfade_ms": 0,
      "semantic_role": null
    },
    {
      "id": "scene_014",
      "start": 68.31,
      "end": 73.942,
      "caption": "Education becomes a commodity. Healthcare becomes a luxury. Housing becomes an investment.",
      "crossfade_ms": 0,
      "semantic_role": null
    }
  ],
