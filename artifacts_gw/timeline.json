  "segments": [
    {
      "id": "scene_001",
      "start": 0.0,
      "end": 3.861,
      "caption": "Welcome back to the show. Today we are diving into something serious.",
      "crossfade_ms": 0,
      "semantic_role": null
    },
    {
      "id": "scene_002",
      "start": 3.861,
      "end": 7.658,
      "caption": "The gender wars. It is not just internet drama anymore.",
      "crossfade_ms": 0,
      "semantic_role": null
    },
    {
      "id": "scene_003",
      "start": 7.658,
      "end": 11.199,
      "caption": "Right. It is actually changing how people form relationships.",
      "crossfade_ms": 0,
      "semantic_role": null
    },
    {
      "id": "scene_004",
      "start": 11.199,
      "end": 14.25,
      "caption": "And the data is alarming. Look at South Korea.",
      "crossfade_ms": 0,
      "semantic_role": null
    },
    {
      "id": "scene_005",
      "start": 14.25,
      "end": 18.773,
      "caption": "Their birth rate dropped to zero point seven two. That is the lowest in the world.",
      "crossfade_ms": 0,
      "semantic_role": null
    },
    {
      "id": "scene_006",
      "start": 18.773,
      "end": 23.53,
      "caption": "Japan is not far behind at one point two. Both countries are shrinking.",
      "crossfade_ms": 0,
      "semantic_role": null
    },
    {
      "id": "scene_007",
      "start": 23.53,
      "end": 27.434,
      "caption": "Young men and women are literally not dating anymore. They have given up.",
      "crossfade_ms": 0,
      "semantic_role": null
    },
    {
      "id": "scene_008",
      "start": 27.434,
      "end": 30.975,
      "caption": "In Korea, there is a movement called the four B movement.",
      "crossfade_ms": 0,
      "semantic_role": null
    },
    {
      "id": "scene_009",
      "start": 30.975,
      "end": 35.86,
      "caption": "No dating, no sex, no marriage, no childbirth. Women are opting out entirely.",
      "crossfade_ms": 0,
      "semantic_role": null
    },
    {
      "id": "scene_010",
      "start": 35.86,
      "end": 40.169,
      "caption": "And men are responding with their own movements. The divide is growing.",
      "crossfade_ms": 0,
      "semantic_role": null
    },
    {
      "id": "scene_011",
      "start": 40.169,
      "end": 43.753,
      "caption": "Social media amplifies the extreme voices on both sides.",
      "crossfade_ms": 0,
      "semantic_role": null
    },
    {
      "id": "scene_012",
      "start": 43.753,
      "end": 48.788,
      "caption": "Every disagreement becomes a battle. Every relationship becomes a power struggle.",
      "crossfade_ms": 0,
      "semantic_role": null
    },
    {
      "id": "scene_013",
      "start": 48.788,
      "end": 51.732,
      "caption": "The result? Loneliness epidemics in both genders.",
      "crossfade_ms": 0,
      "semantic_role": null
    },
    {
      "id": "scene_014",
      "start": 51.732,
      "end": 56.553,
      "caption": "Marriage rates have cratered. Birth rates are collapsing across developed nations.",
      "crossfade_ms": 0,
      "semantic_role": null
    },
    {
      "id": "scene_015",
      "start": 56.553,
      "end": 59.817,
      "caption": "This is not a left or right issue. It is a human issue.",
      "crossfade_ms": 0,
      "semantic_role": null
    },
    {
      "id": "scene_016",
      "start": 59.817,
      "end": 64.02,
      "caption": "When men and women see each other as enemies, society breaks down.",
      "crossfade_ms": 0,
      "semantic_role": null
    },
    {
      "id": "scene_017",
      "start": 64.02,
      "end": 67.945,
      "caption": "The population decline in Korea and Japan is just the beginning.",
      "crossfade_ms": 0,
      "semantic_role": null
    },
    {
      "id": "scene_018",
      "start": 67.945,
      "end": 72.681,
      "caption": "We need to find a way back to mutual understanding. Before it is too late.",
      "crossfade_ms": 0,
      "semantic_role": null
    }
  ],
