  "segments": [
    {
      "id": "seg_001",
      "start": 0.0,
      "end": 3.0,
      "caption": "Black holes are the most extreme objects in the universe.",
      "crossfade_ms": 500,
      "semantic_role": null
    },
    {
      "id": "seg_002",
      "start": 3.66,
      "end": 7.8,
      "caption": "They warp space and time so severely that nothing, not even",
      "crossfade_ms": 500,
      "semantic_role": null
    },
    {
      "id": "seg_003",
      "start": 7.8,
      "end": 11.7,
      "caption": "light can escape. At the edge of a black hole lies the",
      "crossfade_ms": 500,
      "semantic_role": null
    },
    {
      "id": "seg_004",
      "start": 11.7,
      "end": 12.56,
      "caption": "event horizon.",
      "crossfade_ms": 500,
      "semantic_role": null
    },
    {
      "id": "seg_005",
      "start": 13.28,
      "end": 17.14,
      "caption": "Once anything crosses this boundary, it is lost forever to the",
      "crossfade_ms": 500,
      "semantic_role": null
    },
    {
      "id": "seg_006",
      "start": 17.14,
      "end": 21.1,
      "caption": "singularity at the center. Black holes form when massive stars",
      "crossfade_ms": 500,
      "semantic_role": null
    },
    {
      "id": "seg_007",
      "start": 21.1,
      "end": 22.84,
      "caption": "collapse under their own gravity.",
      "crossfade_ms": 500,
      "semantic_role": null
    },
    {
      "id": "seg_008",
      "start": 23.46,
      "end": 27.56,
      "caption": "The resulting density is so extreme that a teaspoon of black",
      "crossfade_ms": 500,
      "semantic_role": null
    },
    {
      "id": "seg_009",
      "start": 27.56,
      "end": 31.28,
      "caption": "hole matter would weigh billions of tons. Near a black hole,",
      "crossfade_ms": 500,
      "semantic_role": null
    },
    {
      "id": "seg_010",
      "start": 31.56,
      "end": 36.1,
      "caption": "time itself slows down. If you could orbit close to one, time",
      "crossfade_ms": 500,
      "semantic_role": null
    },
    {
      "id": "seg_011",
      "start": 36.1,
      "end": 39.2,
      "caption": "would pass more slowly for you than for everyone else in the",
      "crossfade_ms": 500,
      "semantic_role": null
    },
    {
      "id": "seg_012",
      "start": 39.2,
      "end": 42.96,
      "caption": "universe. Black holes remind us that the universe is stranger",
      "crossfade_ms": 500,
      "semantic_role": null
    },
    {
      "id": "seg_013",
      "start": 42.96,
      "end": 44.18,
      "caption": "than we can imagine.",
      "crossfade_ms": 500,
      "semantic_role": null
    },
    {
      "id": "seg_014",
      "start": 44.84,
      "end": 49.0,
      "caption": "They are not destroyers, but the ultimate architects of cosmic",
      "crossfade_ms": 500,
      "semantic_role": null
    },
    {
      "id": "seg_015",
      "start": 49.0,
      "end": 49.56,
      "caption": "structure.",
      "crossfade_ms": 500,
      "semantic_role": null
    }
  ],
